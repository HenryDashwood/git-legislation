{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "git-legislation-web-app",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  "dev": { "port": 3000 },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "API",
      "service": "git-legislation-read-api"
    }
  ]
}
